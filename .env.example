# AI 이미지 분석 / 해외 검색어 생성 설정
#
# 이미지 우선 제품 식별을 배포(Vercel 등 서버리스) 환경에서 쓰려면
# ANTHROPIC_API_KEY를 등록하세요. 키가 있으면 Anthropic 비전 API를 사용하고,
# 없으면 로컬 claude CLI(설치된 환경)로, 그마저 없으면 제목 기반으로 저하 동작합니다.
ANTHROPIC_API_KEY=

# (선택) 사용할 모델. 기본값 claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# (선택) claude CLI 경로 override. 기본값 "claude".
# CLAUDE_CLI_PATH=claude

# (선택) 로컬 claude CLI 폴백을 끄려면 1.
# DISABLE_CLAUDE_CLI=0

# --- eBay Browse API (선택) ---
# developer.ebay.com 앱의 App ID(Client ID)와 Cert ID(Client Secret).
# 키가 있으면 eBay 판매중 매물은 공식 Browse API로 조회하고(스크래핑 차단과 무관),
# 상품 이미지로 동일 제품을 찾는 search_by_image(시각 매칭)도 활성화됩니다.
# 키가 없으면 HTML 스크랩(+jina 프록시 폴백)으로 저하 동작합니다.
# 참고: 판매완료(sold) 시세는 Marketplace Insights API 별도 승인이 필요해
#       키가 있어도 HTML 경로를 사용합니다.
EBAY_APP_ID=
EBAY_CERT_ID=

# (선택) eBay 마켓플레이스. 기본값 EBAY_US.
# EBAY_MARKETPLACE=EBAY_US

# --- jina reader 프록시 (선택) ---
# eBay/야후옥션 등 봇 차단 사이트를 r.jina.ai 리더 프록시로 우회합니다.
# 키 없이도 무료 티어로 동작하지만, 레이트리밋이 잦으면 jina.ai에서 키를 발급해 등록하세요.
JINA_API_KEY=

# --- Supabase (선택) — 저장·관심목록·매입/판매 기록 대시보드 ---
# 값을 넣으면 저장/관심목록/기록 기능이 켜집니다. 없으면 분석기는 그대로 동작합니다.
# 1) supabase.com에서 프로젝트 생성 → 2) supabase/schema.sql 을 SQL Editor에서 실행
# 3) 아래 값을 Vercel 환경변수에 등록 (SERVICE_ROLE_KEY는 서버 전용, 절대 클라이언트 노출 금지)
# 주의: 개인용이라 RLS/인증이 없습니다. 공개 배포 시 접근 제어를 추가하세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
