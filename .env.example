# AI 이미지 분석 / 해외 검색어 생성 설정
#
# 이미지 우선 제품 식별을 배포(Vercel 등 서버리스) 환경에서 쓰려면
# ANTHROPIC_API_KEY를 등록하세요. 키가 있으면 Anthropic 비전 API를 사용하고,
# 없으면 로컬 claude CLI(설치된 환경)로, 그마저 없으면 제목 기반으로 저하 동작합니다.
ANTHROPIC_API_KEY=

# (선택) 사용할 모델. 기본값 claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# (선택) claude CLI 경로 override. 기본값 "claude".
# CLAUDE_CLI_PATH=claude

# (선택) 로컬 claude CLI 폴백을 끄려면 1.
# DISABLE_CLAUDE_CLI=0
